{
  "study_certificate": {
    "label": "Справка об обучении",
    "keywords": ["справка об обучении", "период обучения", "форма обучения", "направление подготовки"],
    "fields": {
      "student_name": {
        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": [
          "(?:ФИО(?: студента)?|Студент|Обучающийся)[:\\s]+([А-ЯЁ][а-яё]+\\s+[А-ЯЁ][а-яё]+(?:\\s+[А-ЯЁ][а-яё]+)?)"
        ]
      },
      "university": {
        "title": "Название вуза",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Название вуза|ВУЗ|Университет)[:\\s]+([^\\n]+)"]
      },
      "program": {
        "title": "Направление подготовки",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Направление подготовки|Направление|Программа)[:\\s]+([^\\n]+)"]
      },
      "study_form": {
        "title": "Форма обучения",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Форма обучения)[:\\s]+([^\\n]+)"]
      },
      "study_period_start": {
        "title": "Начало периода обучения",
        "required": true,
        "kind": "date_period_part",
        "part": "start"
      },
      "study_period_end": {
        "title": "Окончание периода обучения",
        "required": true,
        "kind": "date_period_part",
        "part": "end"
      },
      "issue_number": {
        "title": "Номер выдачи",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Справка\\s*)?№\\s*([A-Za-zА-Яа-яЁё0-9\\-\\/]+)", "Номер\\s+(?:выдачи|справки)[:\\s]+([^\\n]+)"]
      },
      "issue_date": {
        "title": "Дата выдачи",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Дата\\s+выдачи|от)[:\\s]*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4}|[0-9]{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\\s+[0-9]{4})"]
      },
      "signature": {
        "title": "Подпись",
        "required": true,
        "kind": "presence",
        "required_terms": ["подпись"],
        "negative_terms": ["без подписи", "подпись отсутствует", "нет подписи"]
      },
      "seal": {
        "title": "Печать",
        "required": true,
        "kind": "presence",
        "required_terms": ["печать"],
        "negative_terms": ["без печати", "печать отсутствует", "нет печати"]
      }
    }
  },
  "academic_leave_application": {
    "label": "Заявление на академический отпуск",
    "keywords": ["академический отпуск", "заявление", "дата начала отпуска", "дата окончания отпуска"],
    "fields": {
      "student_name": {
        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Ф\\s*И\\s*О\\.?\\s*(?:студента|обучающегося)?|Студент|Обучающийся|Заявитель)[:\\s]+([А-ЯЁа-яё-]+\\s+[А-ЯЁа-яё-]+(?:\\s+[А-ЯЁа-яё-]+)?)"]
      },
      "group": {
        "title": "Группа",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Учебная\\s+)?Группа(?!\\s+и\\s+курс)[:\\s]+([^\\n]+)"]
      },
      "course": {
        "title": "Курс",
        "required": true,
        "kind": "regex",
        "patterns": ["Курс(?:а|у|ом|е)?(?:\\s+обучения)?[:\\s]+([0-9]{1,2})", "\\b([0-9]{1,2})\\s*(?:-й\\s+)?курс(?:а|у|ом|е)?\\b"]
      },
      "leave_reason": {
        "title": "Причина отпуска",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Причина отпуска|Причина)[:\\s]+([^\\n]+)"]
      },
      "leave_start": {
        "title": "Дата начала отпуска",
        "required": true,
        "kind": "labeled_date",
        "labels": ["Дата начала отпуска", "Начало отпуска"],
        "patterns": ["(?:Дата\\s+начала\\s+отпуска|Начало\\s+отпуска|с)[:\\s]*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4}|[0-9]{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\\s+[0-9]{4})(?:\\s+года)?"]
      },
      "leave_end": {
        "title": "Дата окончания отпуска",
        "required": true,
        "kind": "labeled_date",
        "labels": ["Дата окончания отпуска", "Окончание отпуска"],
        "patterns": ["(?:Дата\\s+окончания\\s+отпуска|Окончание\\s+отпуска|по)[:\\s]*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4}|[0-9]{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\\s+[0-9]{4})(?:\\s+года)?"]
      },
      "application_date": {
        "title": "Дата заявления",
        "required": true,
        "kind": "labeled_date",
        "labels": ["Дата заявления", "Заявление от"],
        "patterns": ["(?:Дата\\s+заявления|Заявление\\s+от|от)[:\\s]*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4}|[0-9]{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\\s+[0-9]{4})(?:\\s+года)?"]
      },
      "signature": {
        "title": "Подпись студента",
        "required": true,
        "kind": "presence",
        "required_terms": ["подпись"],
        "negative_terms": ["без подписи", "подпись отсутствует", "нет подписи"]
      }
    }
  },
  "practice_certificate": {
    "label": "Справка о практике",
