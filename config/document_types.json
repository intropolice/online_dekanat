{
  "study_certificate": {
    "label": "Справка об обучении",
    "classification_signals": [
      "Направление подготовки",
      "Форма обучения",
      "Начало периода обучения",
      "Окончание периода обучения"
    ],
    "fields": {
      "student_name": {
        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": [
          "(?:^|\\n)[ \\t]*(?:ФИО(?:[ \\t]+студента)?|Студент|Обучающийся)[:：]?[ \\t]+([А-ЯЁ][а-яё]+(?:[ \\t]+[А-ЯЁ][а-яё]+){1,2})[ \\t]*(?=\\r?$)"
        ]
      },
      "university": {
        "title": "Название вуза",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Название вуза|ВУЗ|Университет)[:\\s]+([^\\n]+)"]
      },
      "program": {
        "title": "Направление подготовки",
        "required": true,
        "kind": "labeled_text",
        "labels": ["Направление подготовки", "Направление", "Программа"]
      },
      "study_form": {
        "title": "Форма обучения",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Форма обучения)[:\\s]+([^\\n]+)"]
      },
      "study_period_start": {
        "title": "Начало периода обучения",
        "required": true,
        "kind": "date_period_part",
        "part": "start"
      },
      "study_period_end": {
        "title": "Окончание периода обучения",
        "required": true,
        "kind": "date_period_part",
        "part": "end"
      },
      "issue_number": {
        "title": "Номер справки",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Справка\\s*)?№\\s*([A-Za-zА-Яа-яЁё0-9\\-\\/]+)", "Номер\\s+(?:выдачи|справки)[:\\s]+([^\\n]+)"]
      },
      "issue_date": {
        "title": "Дата выдачи",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Дата\\s+выдачи|от)[:\\s]*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4}|[0-9]{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\\s+[0-9]{4})"]
      },
      "signature": {
        "title": "Подпись",
        "required": true,
        "kind": "presence",
        "required_terms": ["подпись"],
        "negative_terms": ["без подписи", "подпись отсутствует", "нет подписи"]
      },
      "seal": {
        "title": "Печать",
        "required": true,
        "kind": "presence",
        "required_terms": ["печать"],
        "negative_terms": ["без печати", "печать отсутствует", "нет печати"]
      }
    }
  },
  "academic_leave_application": {
    "label": "Заявление на академический отпуск",
    "classification_signals": [
      "Учебная группа",
      "Причина отпуска",
      "Дата начала отпуска",
      "Дата окончания отпуска"
    ],
    "fields": {
      "student_name": {
        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:^|\\n)[ \\t]*(?:ФИО(?:[ \\t]+студента)?|Студент|Заявитель)[:：]?[ \\t]+([А-ЯЁ][а-яё]+(?:[ \\t]+[А-ЯЁ][а-яё]+){1,2})[ \\t]*(?=\\r?$)"]
      },
      "group": {
        "title": "Группа",
        "required": true,
        "kind": "group"
      },
      "course": {
        "title": "Курс",
        "required": true,
        "kind": "regex",
        "patterns": ["Курс[:：\\s]+(\\d{1,2})"]
      },
      "leave_reason": {
        "title": "Причина отпуска",
        "required": true,
        "kind": "labeled_text",
        "labels": ["Причина отпуска", "Причина"]
      },
      "leave_start": {
        "title": "Дата начала отпуска",
        "required": true,
        "kind": "date",
        "labels": ["Дата начала отпуска", "Начало отпуска"]
      },
      "leave_end": {
        "title": "Дата окончания отпуска",
        "required": true,
        "kind": "date",
        "labels": ["Дата окончания отпуска", "Окончание отпуска"]
      },
      "application_date": {
        "title": "Дата заявления",
        "required": true,
        "kind": "date",
        "labels": ["Дата заявления", "Заявление от"]
      },
      "signature": {
        "title": "Подпись студента",
        "required": true,
        "kind": "presence",
        "required_terms": ["подпись"],
        "negative_terms": ["без подписи", "подпись отсутствует", "нет подписи"]
      }
    }
  },
  "practice_certificate": {
