        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Ф\\s*И\\s*О\\.?\\s*(?:студента|обучающегося)?|Студент|Обучающийся|Практикант)[:\\s]+([А-ЯЁа-яё-]+\\s+[А-ЯЁа-яё-]+(?:\\s+[А-ЯЁа-яё-]+)?)"]
      },
      "organization": {
        "title": "Организация",
        "required": true,
