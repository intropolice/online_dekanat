{
  "study_certificate": {
    "label": "Справка об обучении",
    "keywords": ["справка об обучении", "период обучения", "форма обучения", "направление подготовки"],
    "fields": {
      "student_name": {
        "title": "ФИО студента",
        "required": true,
        "kind": "regex",
        "patterns": [
          "(?:ФИО(?: студента)?|Студент|Обучающийся)[:\\s]+([А-ЯЁ][а-яё]+\\s+[А-ЯЁ][а-яё]+(?:\\s+[А-ЯЁ][а-яё]+)?)"
        ]
      },
      "university": {
        "title": "Название вуза",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Название вуза|ВУЗ|Университет)[:\\s]+([^\\n]+)"]
      },
      "program": {
        "title": "Направление подготовки",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Направление подготовки|Направление|Программа)[:\\s]+([^\\n]+)"]
      },
      "study_form": {
        "title": "Форма обучения",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Форма обучения)[:\\s]+([^\\n]+)"]
      },
      "study_period": {
        "title": "Период обучения",
        "required": true,
        "kind": "regex",
        "patterns": ["(?:Период обучения|Срок обучения)[:\\s]+([^\\n]+)"]
      },
      "issue_number_date": {
        "title": "Номер и дата выдачи",
        "required": true,
        "kind": "regex",
        "patterns": [
          "(?:Справка\\s*)?№\\s*([A-Za-zА-Яа-яЁё0-9\\-\\/]+).*?(?:от|дата выдачи)\\s*([0-9]{1,2}[.\\-/][0-9]{1,2}[.\\-/][0-9]{2,4})",
          "(?:Номер и дата выдачи)[:\\s]+([^\\n]+)"
        ]
      },
      "signature_and_seal": {
        "title": "Подпись и печать",
        "required": true,
        "kind": "presence",
        "required_terms": ["подпись", "печать"],
        "negative_terms": ["без подписи", "подпись отсутствует", "нет подписи", "без печати", "печать отсутствует", "нет печати"]
      }
    }
  },
